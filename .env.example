# Copy to .env and set POSTGRES_PASSWORD locally. Never commit secrets.
# Compose and the local Spring profile read this file from the repository root.
POSTGRES_DB=board_game_master
POSTGRES_USER=board_game_master
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SERVER_PORT=8080
# Optional overrides: omit them to use POSTGRES_* values in the local profile.
# DB_URL=jdbc:postgresql://localhost:5432/board_game_master
# DB_USERNAME=board_game_master
# DB_PASSWORD=
# Production requires DB_URL, DB_USERNAME, DB_PASSWORD as environment variables.
# Active rule ingestion limits (size/overlap measured in UTF-16 characters).
RULE_CHUNK_SIZE=1200
RULE_CHUNK_OVERLAP=200
RULE_MAX_BYTES=1048576
RULE_MAX_CHUNKS=10000
# Active embeddings: disabled by default; OpenAI calls are opt-in.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT=30s
EMBEDDING_MAX_INPUT_CHARACTERS=4000
EMBEDDING_MAX_DOCUMENT_CHUNKS=1000
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
RAG_CANDIDATE_LIMIT=200
RAG_DUPLICATE_OVERLAP=0.85
# Optional short session follow-ups: adds up to one LLM call before retrieval; uses LLM_* settings.
RAG_QUERY_REWRITE_ENABLED=false
# Experimental answer-only review: up to two extra LLM calls; uses LLM_* settings.
RAG_EVIDENCE_REVIEW_ENABLED=false
RAG_EVIDENCE_REVIEW_CANDIDATE_FLOOR=0.35
RAG_EVIDENCE_REVIEW_CANDIDATE_COUNT=12
# Local debugging only: DEBUG prints the effective search query and candidate scores. Keep OFF normally.
RAG_QUERY_DIAGNOSTICS_LEVEL=OFF
# Active answer generation: disabled by default; independent of embedding configuration.
LLM_PROVIDER=disabled
LLM_MODEL=gpt-4.1-mini
# Optional gpt-5.6-luna: none, low, medium, high, xhigh, max. Other models require none.
LLM_REASONING_EFFORT=none
LLM_API_KEY=
LLM_TIMEOUT=30s
LLM_MAX_OUTPUT_TOKENS=800
# Importing a game from a rulebook PDF in /admin: one longer call with the same model and key.
GAME_DRAFT_MAX_OUTPUT_TOKENS=16000
GAME_DRAFT_TIMEOUT=180s
# Baseline answer acceptance gates, not calibrated probabilities or retrieval filters.
ANSWER_MINIMUM_EVIDENCE_SIMILARITY=0.5
ANSWER_HIGH_EVIDENCE_SIMILARITY=0.8
ANSWER_MAX_CONTEXT_CHARACTERS=24000
ANSWER_MINIMUM_QUOTE_CHARACTERS=12
# Local debugging only: DEBUG prints rejected quotes and cited rule text. Keep OFF normally.
ANSWER_QUOTE_DIAGNOSTICS_LEVEL=OFF
# Bounded session conversation context; teaching/navigation need no AI provider.
SESSION_RECENT_MESSAGE_LIMIT=8
SESSION_CONTEXT_CHARACTERS=8000
# Optional speech providers; disabled by default and independent of LLM/embeddings.
STT_PROVIDER=disabled
STT_MODEL=whisper-1
STT_API_KEY=
STT_TIMEOUT=30s
TTS_PROVIDER=disabled
TTS_MODEL=tts-1
TTS_API_KEY=
TTS_TIMEOUT=30s
TTS_VOICE=alloy
VOICE_MAX_AUDIO_BYTES=2097152
# The following remain reserved proposals, not active settings.
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=30
# RAG_CHUNK_* and AI_* remain reserved.
# Text ingestion uses RULE_* independently of embeddings.
