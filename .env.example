# Copy to .env and set POSTGRES_PASSWORD locally. Never commit secrets.
# Compose and the local Spring profile read this file from the repository root.
POSTGRES_DB=board_game_master
POSTGRES_USER=board_game_master
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
SERVER_PORT=8080
# Optional overrides: omit them to use POSTGRES_* values in the local profile.
# DB_URL=jdbc:postgresql://localhost:5432/board_game_master
# DB_USERNAME=board_game_master
# DB_PASSWORD=
# Production requires DB_URL, DB_USERNAME, DB_PASSWORD as environment variables.
# Active rule ingestion limits (size/overlap measured in UTF-16 characters).
RULE_CHUNK_SIZE=1200
RULE_CHUNK_OVERLAP=200
RULE_MAX_BYTES=1048576
RULE_MAX_CHUNKS=10000
# Active embeddings: disabled by default; OpenAI calls are opt-in.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT=30s
EMBEDDING_MAX_INPUT_CHARACTERS=4000
EMBEDDING_MAX_DOCUMENT_CHUNKS=1000
RAG_TOP_K=5
# The following are reserved proposals for later milestones, not active settings.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
STT_PROVIDER=
STT_MODEL=
STT_API_KEY=
TTS_PROVIDER=
TTS_MODEL=
TTS_API_KEY=
RAG_SIMILARITY_THRESHOLD=
RAG_CHUNK_SIZE=
RAG_CHUNK_OVERLAP=
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=30
# RAG_SIMILARITY_THRESHOLD, RAG_CHUNK_* and LLM/speech settings remain reserved.
# Text ingestion uses RULE_* independently of embeddings.
